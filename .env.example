DATABASE_URL="file:./studio.db"
DATABASE_PROVIDER="sqlite"
# For PostgreSQL: set DATABASE_PROVIDER="postgresql" and a PostgreSQL DATABASE_URL.
# Optional fallback. Prefer Settings → AI provider; changes there need no restart.
# Server-side only. Never use NEXT_PUBLIC_ for keys.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4.1-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"
AI_TRANSCRIPTION_MODEL="whisper-1"
# Optional: max_tokens or max_completion_tokens for environment fallback.
AI_TOKEN_PARAMETER="max_completion_tokens"
# Optional 64 hex characters for encrypting saved API keys on hosted deployments.
# If empty, Studio creates .data/ai-provider.key locally. Back it up with your database.
AI_SETTINGS_ENCRYPTION_KEY=""
# false is appropriate for localhost HTTP; set true behind HTTPS.
COOKIE_SECURE="false"
STORAGE_DIR=".data/attachments"
# Set the public origin when deploying behind a reverse proxy, e.g. https://studio.example.com
APP_ORIGIN=""

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
  careerTarget String @default("AI Product Engineer")
  timezone     String @default("Asia/Jakarta")
  createdAt    DateTime @default(now())
  sessions     Session[]
  records      Record[]
  conversations AIConversation[]
  auditLogs    AuditLog[]
  runs         AITask[]
  aiProvider   AIProviderSetting?
}

model AIProviderSetting {
  userId             String @id
  name               String
  baseURL            String
  model              String
  encryptedApiKey    String?
  keyless            Boolean @default(false)
  tokenParameter     String @default("max_tokens")
  embeddingModel     String @default("")
  transcriptionModel String @default("")
  updatedAt          DateTime @updatedAt
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String @id
  userId    String
  expiresAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

// Validated domain records share real foreign keys and a single repository.
// Module-specific fields are validated with Zod before reaching this table.
model Record {
  id        String @id @default(cuid())
  userId    String
  kind      String
  title     String
  description String @default("")
  status    String
  priority  String @default("P2")
  dueDate   DateTime?
  data      Json
  embedding Json?
  goalId    String?
  projectId String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Record? @relation("GoalLink", fields: [goalId], references: [id], onDelete: SetNull)
  goalChildren Record[] @relation("GoalLink")
  project   Record? @relation("ProjectLink", fields: [projectId], references: [id], onDelete: SetNull)
  projectChildren Record[] @relation("ProjectLink")
  parent    Record? @relation("ParentLink", fields: [parentId], references: [id], onDelete: SetNull)
  children  Record[] @relation("ParentLink")
  @@index([userId, kind, status])
  @@index([userId, dueDate])
}

model AIConversation {
  id        String @id @default(cuid())
  userId    String
  agent     String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
  attachments AIAttachment[]
  runs      AITask[]
  @@index([userId, agent])
}

model AIMessage {
  id        String @id @default(cuid())
  conversationId String
  role      String
  content   String
  mode      String @default("ASK")
  createdAt DateTime @default(now())
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AIAttachment {
  id        String @id @default(cuid())
  conversationId String
  name      String
  mimeType  String
  size      Int
  key       String
  createdAt DateTime @default(now())
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AITask {
  id        String @id @default(cuid())
  userId    String
  conversationId String?
  agent     String
  instruction String
  status    String @default("WORKING")
  output    String?
  error     String?
  createdAt DateTime @default(now())
  startedAt DateTime @default(now())
  finishedAt DateTime?
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  @@index([userId, agent, status])
}

model AuditLog {
  id        String @id @default(cuid())
  userId    String
  source    String
  action    String
  target    String
  previous  Json?
  next      Json?
  conversationId String?
  result    String
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
